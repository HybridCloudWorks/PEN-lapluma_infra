{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "resourceNamePrefix": {
      "value": "${AZURE_RESOURCE_NAME_PREFIX}"
    },
    "enableProvisioning": {
      "value": false
    },
    "sqlEntraAdminObjectId": {
      "value": "${AZURE_SQL_ENTRA_ADMIN_OBJECT_ID}"
    },
    "sqlEntraAdminDisplayName": {
      "value": "${AZURE_SQL_ENTRA_ADMIN_DISPLAY_NAME}"
    },
    "hsmInitialAdminObjectId": {
      "value": "${AZURE_HSM_INITIAL_ADMIN_OBJECT_ID}"
    },
    "vnetAddressPrefix": {
      "value": "${LAPLUMA_VNET_ADDRESS_PREFIX}"
    },
    "subnetPrefixes": {
      "value": {
        "core": "${LAPLUMA_CORE_SUBNET_PREFIX}",
        "processing": "${LAPLUMA_PROCESSING_SUBNET_PREFIX}",
        "ai": "${LAPLUMA_AI_SUBNET_PREFIX}",
        "functions": "${LAPLUMA_FUNCTIONS_SUBNET_PREFIX}",
        "privateEndpoints": "${LAPLUMA_PRIVATE_ENDPOINTS_SUBNET_PREFIX}",
        "apim": "${LAPLUMA_APIM_SUBNET_PREFIX}"
      }
    },
    "dataClassification": {
      "value": "${LAPLUMA_DATA_CLASSIFICATION}"
    },
    "tags": {
      "value": {
        "owner": "${AZURE_RESOURCE_OWNER}",
        "cost-center": "${AZURE_COST_CENTER}",
        "data-classification": "sensitive-pii"
      }
    },
    "retention": {
      "value": {
        "logAnalyticsDays": "${LAPLUMA_LOG_ANALYTICS_RETENTION_DAYS}",
        "blobSoftDeleteDays": "${LAPLUMA_BLOB_SOFT_DELETE_DAYS}",
        "containerSoftDeleteDays": "${LAPLUMA_CONTAINER_SOFT_DELETE_DAYS}",
        "keyVaultSoftDeleteDays": "${LAPLUMA_KEY_VAULT_SOFT_DELETE_DAYS}",
        "hsmSoftDeleteDays": "${LAPLUMA_HSM_SOFT_DELETE_DAYS}",
        "blobVersionDays": "${LAPLUMA_BLOB_VERSION_DAYS}",
        "erasureSlaDays": "${LAPLUMA_ERASURE_SLA_DAYS}",
        "auditImmutabilityDays": "${LAPLUMA_AUDIT_IMMUTABILITY_DAYS}"
      }
    },
    "capacity": {
      "value": {
        "sqlSkuName": "${LAPLUMA_SQL_SKU_NAME}",
        "sqlSkuCapacity": "${LAPLUMA_SQL_SKU_CAPACITY}",
        "sqlMinCapacity": "${LAPLUMA_SQL_MIN_CAPACITY}",
        "sqlAutoPauseMinutes": "${LAPLUMA_SQL_AUTO_PAUSE_MINUTES}",
        "cosmosMaxThroughput": "${LAPLUMA_COSMOS_MAX_THROUGHPUT}",
        "serviceBusCapacity": "${LAPLUMA_SERVICE_BUS_CAPACITY}",
        "serviceBusPartitions": "${LAPLUMA_SERVICE_BUS_PARTITIONS}",
        "hsmSkuName": "${LAPLUMA_HSM_SKU_NAME}",
        "registrySku": "${LAPLUMA_REGISTRY_SKU}"
      }
    },
    "resilience": {
      "value": {
        "sqlZoneRedundant": "${LAPLUMA_SQL_ZONE_REDUNDANT}",
        "cosmosZoneRedundant": "${LAPLUMA_COSMOS_ZONE_REDUNDANT}",
        "auditStorageSku": "${LAPLUMA_AUDIT_STORAGE_SKU}",
        "defaultStorageSku": "${LAPLUMA_DEFAULT_STORAGE_SKU}"
      }
    },
    "messagingBaseline": {
      "value": {
        "duplicateDetectionWindow": "${LAPLUMA_DUPLICATE_DETECTION_WINDOW}",
        "queueMessageTimeToLive": "${LAPLUMA_QUEUE_MESSAGE_TTL}",
        "queueLockDuration": "${LAPLUMA_QUEUE_LOCK_DURATION}",
        "queueMaxDeliveryCount": "${LAPLUMA_QUEUE_MAX_DELIVERY_COUNT}",
        "topicMessageTimeToLive": "${LAPLUMA_TOPIC_MESSAGE_TTL}"
      }
    },
    "functionsPythonVersion": {
      "value": "${LAPLUMA_FUNCTIONS_PYTHON_VERSION}"
    }
  }
}
