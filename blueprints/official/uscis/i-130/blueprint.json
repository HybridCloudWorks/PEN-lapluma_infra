        "beneficiary.given_name": "Carlos",
        "beneficiary.family_name": "Santos",
        "beneficiary.relationship": "Spouse",
        "marriage.date": "2015-10-24"
      }
    },
    {
      "fixtureName": "invalid_missing_petitioner_name",
      "expectedValid": false,
      "inputValues": {
        "beneficiary.given_name": "Carlos",
        "beneficiary.family_name": "Santos",
        "beneficiary.relationship": "Spouse",
        "marriage.date": "2015-10-24"
      }
    },
    {
      "fixtureName": "invalid_bad_ssn",
      "expectedValid": false,
      "inputValues": {
        "petitioner.given_name": "María",
        "petitioner.family_name": "Santos",
        "petitioner.dob": "1985-06-15",
        "petitioner.ssn": "BAD-SSN",
        "beneficiary.given_name": "Carlos",
        "beneficiary.family_name": "Santos",
        "beneficiary.relationship": "Spouse",
        "marriage.date": "2015-10-24"
      }
    },
    {
      "fixtureName": "invalid_spouse_missing_marriage_date",
      "expectedValid": false,
      "inputValues": {
        "petitioner.given_name": "María",
        "petitioner.family_name": "Santos",
        "petitioner.dob": "1985-06-15",
        "petitioner.ssn": "123-45-6789",
        "beneficiary.given_name": "Carlos",
        "beneficiary.family_name": "Santos",
        "beneficiary.relationship": "Spouse"
      }
    },
    {
      "fixtureName": "valid_parent_petition_no_marriage_date",
      "expectedValid": true,
      "inputValues": {
        "petitioner.given_name": "María",
        "petitioner.family_name": "Santos",
        "petitioner.dob": "1985-06-15",
        "petitioner.ssn": "123-45-6789",
        "beneficiary.given_name": "Elena",
        "beneficiary.family_name": "Hernández",
        "beneficiary.relationship": "Parent"
      }
    }
  ]
}
