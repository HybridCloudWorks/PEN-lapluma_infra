{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "namespace": "uscis",
  "blueprintId": "i-130",
  "revision": 1,
  "title": "Petition for Alien Relative",
  "issuer": "U.S. Citizenship and Immigration Services",
  "officialEditionDate": "2024-04-01",
  "preparationMode": "FILLABLE_PDF",
  "artifactType": "OFFICIAL_PDF",
  "accessScope": "SHARED_OFFICIAL",
  "source": {
    "url": "https://www.uscis.gov/sites/default/files/document/forms/i-130.pdf",
    "sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
    "lastVerified": "2026-09-13T00:00:00Z"
  },
  "sections": [
    {
      "sectionId": "sec_petitioner",
      "title": "Information About Petitioner",
      "isRepeatable": false,
      "overflowStrategy": "ATTACHMENT_ADDENDUM"
    },
    {
      "sectionId": "sec_beneficiary",
      "title": "Information About Beneficiary",
      "isRepeatable": false,
      "overflowStrategy": "ATTACHMENT_ADDENDUM"
    },
    {
      "sectionId": "sec_marriage_history",
      "title": "Marital Information",
      "isRepeatable": false,
      "overflowStrategy": "ATTACHMENT_ADDENDUM",
      "condition": {
        "field": "beneficiary.relationship",
        "operator": "equals",
        "value": "Spouse"
      }
    },
    {
      "sectionId": "sec_beneficiary_children",
      "title": "Beneficiary Children",
      "isRepeatable": true,
      "maxOccurs": 5,
      "overflowStrategy": "ATTACHMENT_ADDENDUM"
    }
  ],
  "fields": [
    {
      "canonicalPath": "petitioner.given_name",
      "sectionId": "sec_petitioner",
      "type": "string",
      "label": "Petitioner Given Name",
      "required": true,
      "maxLength": 30,
      "characterSet": "UNICODE_STANDARD",
      "attributedRole": "PETITIONER",
      "pdfFieldMapping": "form1[0].#subform[0].Pt1Line1a_GivenName[0]"
    },
    {
      "canonicalPath": "petitioner.family_name",
      "sectionId": "sec_petitioner",
      "type": "string",
      "label": "Petitioner Family Name",
      "required": true,
      "maxLength": 30,
      "characterSet": "UNICODE_STANDARD",
      "attributedRole": "PETITIONER",
      "pdfFieldMapping": "form1[0].#subform[0].Pt1Line1b_FamilyName[0]"
    },
    {
      "canonicalPath": "petitioner.dob",
      "sectionId": "sec_petitioner",
      "type": "date",
      "label": "Petitioner Date of Birth",
      "required": true,
      "attributedRole": "PETITIONER"
    },
    {
      "canonicalPath": "petitioner.ssn",
      "sectionId": "sec_petitioner",
      "type": "string",
      "label": "Social Security Number",
      "required": false,
      "attributedRole": "PETITIONER"
    },
    {
      "canonicalPath": "beneficiary.given_name",
      "sectionId": "sec_beneficiary",
      "type": "string",
      "label": "Beneficiary Given Name",
      "required": true,
      "maxLength": 30,
      "characterSet": "UNICODE_STANDARD",
      "attributedRole": "BENEFICIARY"
    },
    {
      "canonicalPath": "beneficiary.family_name",
      "sectionId": "sec_beneficiary",
      "type": "string",
      "label": "Beneficiary Family Name",
      "required": true,
      "maxLength": 30,
      "characterSet": "UNICODE_STANDARD",
      "attributedRole": "BENEFICIARY"
    },
    {
      "canonicalPath": "beneficiary.relationship",
      "sectionId": "sec_beneficiary",
      "type": "choice",
      "label": "Relationship to Petitioner",
      "required": true,
      "choices": ["Spouse", "Parent", "Child", "Sibling"],
      "attributedRole": "BENEFICIARY"
    },
    {
      "canonicalPath": "marriage.date",
      "sectionId": "sec_marriage_history",
      "type": "date",
      "label": "Date of Current Marriage",
      "required": false,
      "condition": {
        "field": "beneficiary.relationship",
        "operator": "equals",
        "value": "Spouse"
      },
      "attributedRole": "PETITIONER"
    },
    {
      "canonicalPath": "beneficiary_children[].name",
      "sectionId": "sec_beneficiary_children",
      "type": "string",
      "label": "Child Full Name",
      "required": false,
      "maxLength": 40,
      "characterSet": "UNICODE_STANDARD",
      "attributedRole": "BENEFICIARY",
      "pdfFieldMapping": "form1[0].#subform[0].Pt4Line{index}a_ChildName[0]"
    }
  ],
  "validationRules": [
    {
      "ruleId": "ssn_format",
      "type": "regex",
      "expression": "petitioner.ssn:^\\d{3}-\\d{2}-\\d{4}$",
      "errorMessage": "SSN must be in format 000-00-0000"
    },
    {
      "ruleId": "dob_range",
      "type": "range",
      "expression": "petitioner.dob:1900-01-01:2026-09-14",
      "errorMessage": "Date of birth must be valid past date"
    },
    {
      "ruleId": "spouse_marriage_date_required",
      "type": "conditional_required",
      "expression": "when:beneficiary.relationship==Spouse:then_required:marriage.date",
      "errorMessage": "Date of current marriage is required when petitioning for a spouse"
    }
  ],
  "evidenceRequirements": [
    {
      "code": "PROOFOFCITIZENSHIP",
      "title": "Proof of U.S. Citizenship",
      "attributedRole": "PETITIONER",
      "isConditional": false,
      "acceptedMimeTypes": [
        "application/pdf",
        "image/jpeg",
        "image/png"
      ]
    },
    {
      "code": "MARRIAGECERTIFICATE",
      "title": "Marriage Certificate",
      "attributedRole": "BENEFICIARY",
      "isConditional": true,
      "acceptedMimeTypes": [
        "application/pdf",
        "image/jpeg",
        "image/png"
      ]
    }
  ],
  "syntheticFixtures": [
