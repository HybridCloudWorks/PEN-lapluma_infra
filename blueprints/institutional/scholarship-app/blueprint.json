      "acceptedMimeTypes": [
        "application/pdf"
      ]
    },
    {
      "code": "INCOME_VERIFICATION",
      "title": "Household Income Verification Form",
      "attributedRole": "STUDENT",
      "isConditional": true,
      "acceptedMimeTypes": [
        "application/pdf"
      ]
    }
