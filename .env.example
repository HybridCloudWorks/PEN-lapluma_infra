# AZD environment template — every variable substituted into infra/main.parameters.json.
#
# Copy to an AZD environment (`azd env set <NAME> <VALUE>`, which writes .azure/<env>/.env) or
# export into the shell before `azd provision`. This file is tracked, so it carries names and
# comments only: never commit a value here, and never add a secret to it in any environment.
#
# The Configuration Contract wiki page is the descriptive reference — expected format, owning role,
# and consuming component for each variable. This file is the machine-adjacent checklist, and
# tools/validate_foundation.py fails if the two sets of names drift from the parameter file.
#
# AZD resolves the target subscription and tenant from `azd auth login` and `azd env new`; they are
# not parameters of infra/main.bicep and therefore are not listed here.
#
# Provisioning stays blocked regardless of what is set here: enableProvisioning is pinned to false
# in infra/main.parameters.json and restricted to false by the Bicep @allowed list.

# Approved AZD-safe environment name. Also emitted as the azd-env-name tag.
AZURE_ENV_NAME=

# Azure region for the pilot data plane. US-only; eastus2.
AZURE_LOCATION=

# 3-12 lowercase alphanumeric characters, seeding every generated resource name.
# Globally unique names must be checked before Azure validation or provisioning.
AZURE_RESOURCE_NAME_PREFIX=

# Entra group object GUID that becomes the Entra-only SQL administrator.
AZURE_SQL_ENTRA_ADMIN_OBJECT_ID=

# Display name of that same Entra group, recorded as SQL administrator metadata.
AZURE_SQL_ENTRA_ADMIN_DISPLAY_NAME=

# Entra principal GUID bootstrapped as the initial Managed HSM administrator.
# Purge protection makes a wrong value expensive to undo; confirm R-10 first.
AZURE_HSM_INITIAL_ADMIN_OBJECT_ID=

# VNet address space in CIDR notation. Proposed 10.42.0.0/16, pending R-09.
LAPLUMA_VNET_ADDRESS_PREFIX=

# Core Container Apps environment subnet. Proposed 10.42.0.0/23.
LAPLUMA_CORE_SUBNET_PREFIX=

# Processing Container Apps environment subnet. Proposed 10.42.2.0/23.
LAPLUMA_PROCESSING_SUBNET_PREFIX=

# AI Container Apps environment subnet. Proposed 10.42.4.0/23.
LAPLUMA_AI_SUBNET_PREFIX=

# Functions integration subnet. Proposed 10.42.6.0/24.
LAPLUMA_FUNCTIONS_SUBNET_PREFIX=

# Private endpoint subnet. Proposed 10.42.7.0/24.
LAPLUMA_PRIVATE_ENDPOINTS_SUBNET_PREFIX=

# Accountable team or role, applied as the owner tag on every resource.
AZURE_RESOURCE_OWNER=

# Organization cost-center identifier, applied as the cost-center tag on every resource.
AZURE_COST_CENTER=

# --- Infrastructure baselines ---
#
# Each is a planning baseline, not an approved value. Every one is substituted as a string because
# AZD substitutes textually into infra/main.parameters.json, which must stay valid JSON; main.bicep
# converts them once and passes typed values to the modules. Leaving one unset substitutes an empty
# string, which fails the @minLength(1) guard on its field rather than deploying a surprise.
#
# The Configuration Contract wiki page carries the current default for each.

# Log Analytics workspace retention in days. 30-730. Baseline 365, pending R-11.
LAPLUMA_LOG_ANALYTICS_RETENTION_DAYS=

# Blob soft-delete window in days. Baseline 7, pending R-11.
LAPLUMA_BLOB_SOFT_DELETE_DAYS=

# Container soft-delete window in days. Baseline 7, pending R-11.
LAPLUMA_CONTAINER_SOFT_DELETE_DAYS=

# Key Vault soft-delete window in days. 7-90. Baseline 90, pending R-11.
LAPLUMA_KEY_VAULT_SOFT_DELETE_DAYS=

# Managed HSM soft-delete window in days. 7-90. Baseline 90, pending R-11.
LAPLUMA_HSM_SOFT_DELETE_DAYS=

# Azure SQL SKU name. Baseline GP_S_Gen5, pending R-03.
LAPLUMA_SQL_SKU_NAME=

# Azure SQL serverless maximum vCores. Baseline 2, pending R-03.
LAPLUMA_SQL_SKU_CAPACITY=

# Azure SQL serverless minimum vCores; a decimal. Baseline 0.5, pending R-03.
LAPLUMA_SQL_MIN_CAPACITY=

# Azure SQL auto-pause delay in minutes; -1 disables. Baseline 60, pending TODO 3.2.
LAPLUMA_SQL_AUTO_PAUSE_MINUTES=

# Cosmos autoscale ceiling in RU/s. 1000-1000000. Baseline 1000, pending R-03.
LAPLUMA_COSMOS_MAX_THROUGHPUT=

# Service Bus Premium messaging units. 1, 2, 4, 8, or 16. Baseline 1, pending R-03.
LAPLUMA_SERVICE_BUS_CAPACITY=

# Service Bus Premium messaging partitions. 1-4. Baseline 1, pending R-03.
LAPLUMA_SERVICE_BUS_PARTITIONS=

# Managed HSM SKU. Standard_B1 or Custom_B32. Baseline Standard_B1, pending R-03.
LAPLUMA_HSM_SKU_NAME=

# SQL zone redundancy, true or false. Baseline false, pending TODO 3.2.
LAPLUMA_SQL_ZONE_REDUNDANT=

# Cosmos zone redundancy, true or false. Baseline false, pending TODO 3.2.
LAPLUMA_COSMOS_ZONE_REDUNDANT=

# Redundancy for the audit storage account. Baseline Standard_ZRS, pending TODO 3.2.
LAPLUMA_AUDIT_STORAGE_SKU=

# Redundancy for the quarantine, documents, and packages accounts. Baseline Standard_LRS.
LAPLUMA_DEFAULT_STORAGE_SKU=

# Duplicate-detection window, ISO 8601 duration. Baseline PT1H.
LAPLUMA_DUPLICATE_DETECTION_WINDOW=

# Queue message time to live, ISO 8601 duration. Baseline P7D, pending R-11.
LAPLUMA_QUEUE_MESSAGE_TTL=

# Queue lock duration, ISO 8601 duration, maximum PT5M. Baseline PT5M.
LAPLUMA_QUEUE_LOCK_DURATION=

# Deliveries before a message is dead-lettered. Baseline 5.
LAPLUMA_QUEUE_MAX_DELIVERY_COUNT=

# Topic message time to live, ISO 8601 duration. Baseline P14D, pending R-11.
LAPLUMA_TOPIC_MESSAGE_TTL=

# --- Application settings ---
#
# Consumed by the services at runtime rather than substituted into infra/main.parameters.json, so
# they are checked differently: every %NAME% binding in src/functions must be declared here, and
# every name declared here must appear somewhere in src/.

# Six-field NCRONTAB expression for the catalog acquisition sweep. Value pending R-16.
ACQUISITION_SCHEDULE=

# Durable Functions task hub. Must be unique per environment or two environments share a hub.
DURABLE_TASK_HUB_NAME=

# Listener port for the processing health surface. Defaults to 8080 in the container.
PORT=
