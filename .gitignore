.DS_Store
.env
.env.*
!.env.example
.azure/*/.env
.azure/*/config.json
**/bin/
**/obj/
**/__pycache__/
**/*.py[cod]
**/.venv/
infra/main.json

# Trivy scan artifacts. CI writes these into the workspace; the cache directory is shared between
# the reporting scan and the enforcing scan so the vulnerability database is downloaded once.
.trivy-cache/
trivy-*.json
trivy-*.sarif
arm-template.json

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
*.tfvars
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
