<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <!-- Microsoft.Data.SqlClient 7.0.x and 7.1.x resolve System.Security.Cryptography.Pkcs 9.0.13–9.0.18,
         inside the range of GHSA-846f-f764-76mx (high) and GHSA-2fmv-rv2c-59x7; NuGet audit fails the
         restore under TreatWarningsAsErrors. Pin the first patched 9.0.x until SqlClient carries it. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <!-- The Cosmos SDK still requires a Newtonsoft.Json reference for its own serializer, even
         though nothing here uses it: System.Text.Json serialises every contract type. -->
    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.62.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Npgsql" Version="9.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Sql\**\*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
