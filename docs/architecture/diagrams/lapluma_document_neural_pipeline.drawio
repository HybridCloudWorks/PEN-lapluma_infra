" /></mxCell><mxCell id="signer" value="&lt;b&gt;Authentic V4 URL Signer&lt;/b&gt;&lt;br/&gt;Google IAM signBlob RSA Signature&lt;br/&gt;Short-Lived (15 min) Narrow Scope" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#FBBC04;strokeWidth=2;fontFamily=Helvetica;fontSize=11;fontColor=#B06000;shadow=1;" vertex="1" parent="1"><mxGeometry x="420" y="200" width="280" height="80" as="geometry" /></mxCell><mxCell id="gcs_quar" value="&lt;b&gt;GCS Quarantine Bucket&lt;/b&gt;&lt;br/&gt;Direct Resumable PUT Upload&lt;br/&gt;Isolated from Production Catalog" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#FCE8E6;strokeColor=#EA4335;strokeWidth=2;fontFamily=Helvetica;fontSize=11;fontColor=#C5221F;shadow=1;" vertex="1" parent="1"><mxGeometry x="420" y="310" width="280" height="80" as="geometry" /></mxCell><mxCell id="complete" value="&lt;b&gt;Authentic Storage Verifier&lt;/b&gt;&lt;br/&gt;POST /v1/documents/.../complete&lt;br/&gt;CRC32C, Size &amp; Hash Verification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#FBBC04;strokeWidth=2;fontFamily=Helvetica;fontSize=11;fontColor=#B06000;shadow=1;" vertex="1" parent="1"><mxGeometry x="420" y="420" width="280" height="80" as="geometry" /></mxCell><mxCell id="ps_event" value="&lt;b&gt;Pub/Sub Notification&lt;/b&gt;&lt;br/&gt;OBJECT_FINALIZE Trigger&lt;br/&gt;doc-processing-requests Topic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#34A853;strokeWidth=2;fontFamily=Helvetica;fontSize=11;fontColor=#0D652D;shadow=1;" vertex="1" parent="1"><mxGeometry x="780" y="100" width="340" height="80" as="geometry" /></mxCell><mxCell id="doc_worker" value="&lt;b&gt;Python Document Worker&lt;/b&gt;&lt;br/&gt;Cloud Run Execution (Concurrency=1)&lt;br/&gt;Isolated Ephemeral Sandboxing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#34A853;strokeWidth=2;fontFamily=Helvetica;fontSize=11;fontColor=#0D652D;shado