<mxfile host="app.diagrams.net" modified="2026-09-18T03:00:00.000Z" agent="LaPluma-Architecture-Generator" version="24.0.0" type="device"><diagram id="d3" name="LaPluma Document Processing &amp; Neural Vision Pipeline"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c_ondevice" value="1. On-Device Neural Vision (Zero-Cloud-Leakage)" style="swimlane;whiteSpace=wrap;html=1;fontFamily=Helvetica,Arial;fontSize=13;fontStyle=1;align=center;horizontal=1;startSize=28;rounded=1;arcSize=4;collapsible=0;container=1;fillColor=#F8F9FA;strokeColor=#4285F4;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="320" height="560" as="geometry" /></mxCell><mxCell id="c_upload" value="2. Direct Cloud Storage Ingress" style="swimlane;whiteSpace=wrap;html=1;fontFamily=Helvetica,Arial;fontSize=13;fontStyle=1;align=center;horizontal=1;startSize=28;rounded=1;arcSize=4;collapsible=0;container=1;fillColor=#FDF8E2;strokeColor=#FBBC04;" vertex="1" parent="1"><mxGeometry x="400" y="40" width="320" height="560" as="geometry" /></mxCell><mxCell id="c_pipeline" value="3. Asynchronous Worker Processing" style="swimlane;whiteSpace=wrap;html=1;fontFamily=Helvetica,Arial;fontSize=13;fontStyle=1;align=center;horizontal=1;startSize=28;rounded=1;arcSize=4;collapsible=0;container=1;fillColor=#E6F4EA;strokeColor=#34A853;" vertex="1" parent="1"><mxGeometry x="760" y="40" width="380" height="560" as="geometry" /></mxCell><mxCell id="cam" value="&lt;b&gt;Camera Feed (10Hz Sampled)&lt;/b&gt;&lt;br/&gt;PixelBuffer Stream&lt;br/&gt;Background Processing Actor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;strokeWidth=2;fontFamily=Helvetica;fontSize=11;fontColor=#174EA6;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="280" height="70" as="geometry" /></mxCell><